 "notes": "WP8/D4 auxiliary lexicon, frozen before any D4 outcome was computed. style_pool is copied verbatim from the scout list scout_abstract-llm-vocab/lexicon.py STYLE_POOL (hand-labelled non-topical rhetoric/style tokens) and is used only for the year-specific LLM-style density (PLAN D4 L set). snowclones lists the v1 features.TEMPLATES keys counted as fixed-frame snowclones for the H4e atlas 'snowclone share'; generic openers (towards, rethinking, revisiting, on_the, understanding, demystifying, learning_to, a_simple, empirical_study, beyond, at_scale, x_for_y_via_z) are excluded because they are single-word or genre openers rather than frames.",
 "style_density_rule": {
  "tokens": "(?u)\\b[a-z][a-z]+\\b on the NFKC lower-cased abstract, binary per abstract",
  "baseline_years": [
   2021,
   2022,
   2023
  ],
  "baseline": "cons = max(OLS line through 2021-23 extrapolated to Y (floored at 0), max(p2022, p2023))",
  "select": "ratio_cons >= 2 and z_cons > 4 in year Y, computed on U",
  "pre_2024": "uses the 2024 word list",
  "density": "100 * (# distinct selected words of the paper's year list) / (# whitespace words in abstract)"
 },
